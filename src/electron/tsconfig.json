{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.electron.tsbuildinfo",
    "target": "esnext",
    "lib": ["ESNext"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "outDir": "../../dist-electron",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["."]
}
